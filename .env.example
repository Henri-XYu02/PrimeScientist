# Copy to .env and fill in your own keys. Never commit the resulting .env.

# ── LLM API keys ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...
HF_TOKEN=hf_...

# ── Optional ────────────────────────────────────────────────────────────────
# Use a Claude Code / Codex subscription instead of API billing.
USE_SUBSCRIPTION=0

# Run the FIRE-Bench agent inside Docker (recommended; isolates pip installs
# and avoids polluting the host conda env).
FIREBENCH_USE_DOCKER=1

# Override the large-file storage location for per-run logs/sandboxes/results.
# Default: <repo>/fire_bench_data
# FIRE_BENCH_DATA=/scratch/fire_bench_data

# Override output dirs for search trees / vanilla runs (default: ./search_tree,
# ./vanilla_runs, relative to the cwd where you invoke run_search.py).
# FIRE_BENCH_SEARCH_TREE=/scratch/search_tree
# FIRE_BENCH_VANILLA_RUNS=/scratch/vanilla_runs

# Override the host directory containing codex auth (mounted into the
# FIRE-Bench docker container). Default: ~/.codex
# CODEX_AUTH_DIR=/home/me/.codex
