# Copy to .env and fill in your own keys. Never commit the resulting .env.

# ── LLM API keys ─────────────────────────────────────────────────────────────
# Drives the codex agent and the reflector.
OPENAI_API_KEY=sk-...

# Passed through to task sandboxes only — some FIRE-Bench papers call these
# providers as the *subject* of the experiment. Not used to run any agent.
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...
HF_TOKEN=hf_...

# ── Optional ────────────────────────────────────────────────────────────────
# Use a Codex subscription instead of API billing.
USE_SUBSCRIPTION=0

# Run the FIRE-Bench agent inside Docker (recommended; isolates pip installs
# and avoids polluting the host conda env).
FIREBENCH_USE_DOCKER=1

# ── Container runtime ────────────────────────────────────────────────────────
# Both benchmarks default to Docker. On hosts without it (no docker group, no
# root), switch to enroot instead:
#
# AutoLab — builds task images by replaying their Dockerfile under enroot.
# AUTOLAB_CONTAINER_RUNTIME=enroot
# Where the built/imported .sqsh images are cached.
# AUTOLAB_ENROOT_IMAGE_DIR=/scratch/$USER/enroot_images
#
# FIRE-Bench — runs the codex agent from a prebuilt .sqsh (mutually exclusive
# with FIREBENCH_USE_DOCKER; the image must be built out-of-band via
# `enroot import`, so there is no default).
# FIREBENCH_USE_ENROOT=1
# FIREBENCH_CODEX_ENROOT_IMAGE=/scratch/$USER/enroot_images/firebench-codex.sqsh
# FIREBENCH_ENROOT_GPU=all
# FIREBENCH_LIBNVIDIA_ML=/usr/lib/x86_64-linux-gnu/libnvidia-ml.so.1

# Override the large-file storage location for per-run logs/sandboxes/results.
# Default: <repo>/fire_bench_data
# FIRE_BENCH_DATA=/scratch/fire_bench_data

# Override output dirs for search trees / vanilla runs (default: ./search_tree,
# ./vanilla_runs, relative to the cwd where you invoke run_search.py).
# FIRE_BENCH_SEARCH_TREE=/scratch/search_tree
# FIRE_BENCH_VANILLA_RUNS=/scratch/vanilla_runs

# Override the host directory containing codex auth.json (mounted into the
# FIRE-Bench docker container when FIREBENCH_USE_DOCKER=1). Default: ~/.codex
# CODEX_AUTH_DIR=/path/to/.codex
